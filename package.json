{
  "name": "homeschool-hub",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "EXPO_USE_METRO_WATCHER=1 NODE_OPTIONS=\"--max-old-space-size=4096\" WATCHMAN_DISABLE=true expo start --dev-client --clear",
    "ios": "EXPO_USE_METRO_WATCHER=1 NODE_OPTIONS=\"--max-old-space-size=4096\" WATCHMAN_DISABLE=true expo run:ios",
    "android": "EXPO_USE_METRO_WATCHER=1 NODE_OPTIONS=\"--max-old-space-size=4096\" WATCHMAN_DISABLE=true expo run:android",
    "web": "EXPO_USE_METRO_WATCHER=1 NODE_OPTIONS=\"--max-old-space-size=4096\" WATCHMAN_DISABLE=true expo start --web",
    "clean": "watchman watch-del-all && rm -rf node_modules/ && rm -rf $TMPDIR/metro-* && npm cache clean --force && npm install",
    "pods": "cd ios && pod install && cd ..",
    "reset": "watchman watch-del-all && rm -rf $TMPDIR/metro-* && expo start -c"
  },
  "resolutions": {
    "react": "18.2.0",
    "react-native": "0.73.6",
    "firebase": "10.8.0",
    "@reduxjs/toolkit": "^1.9.7"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.0.0",
    "@react-native-async-storage/async-storage": "1.21.0",
    "@react-native-community/datetimepicker": "7.7.0",
    "@react-native-community/netinfo": "11.1.0",
    "@react-native-picker/picker": "^2.6.1",
    "@react-navigation/bottom-tabs": "^6.5.11",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "@reduxjs/toolkit": "^1.9.7",
    "@types/react": "~18.2.45",
    "expo": "~50.0.7",
    "expo-av": "~13.10.6",
    "expo-constants": "~15.4.6",
    "expo-dev-client": "~3.3.12",
    "expo-font": "~11.10.3",
    "expo-modules-core": "~1.11.14",
    "expo-status-bar": "~1.11.1",
    "firebase": "^10.8.0",
    "react": "18.2.0",
    "react-native": "0.73.6",
    "react-native-calendars": "^1.1307.0",
    "react-native-chart-kit": "^6.12.0",
    "react-native-gesture-handler": "~2.14.0",
    "react-native-reanimated": "~3.6.2",
    "react-native-safe-area-context": "4.8.2",
    "react-native-screens": "~3.29.0",
    "react-native-svg": "14.1.0",
    "react-redux": "^8.1.3",
    "typescript": "^5.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react-native": "^0.72.8",
    "react-native-dotenv": "^3.4.11"
  }
}
